{
  "name": "@lbrx/lbrx-dictionary",
  "version": "0.1.0",
  "private": true,
  "description": "PocketBase-backed dictionary lookup plugin for Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs watch",
    "build": "tsc --noEmit -p tsconfig.json && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "clean": "rm -f main.js"
  },
  "dependencies": {
    "@lbrx/shared-core": "workspace:*"
  },
  "devDependencies": {
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.28.0",
    "@types/node": "^20.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.24.0",
    "obsidian": "latest",
    "typescript": "^5.5.0"
  }
}
