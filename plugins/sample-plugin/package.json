{
  "name": "@lbrx/sample-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Sample/template LBRX Obsidian plugin.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs watch",
    "build": "tsc --noEmit -p tsconfig.json && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "clean": "rm -f main.js"
  },
  "dependencies": {
    "@lbrx/shared-core": "workspace:*",
    "@lbrx/shared-settings": "workspace:*",
    "@lbrx/shared-ui": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.24.0",
    "obsidian": "latest",
    "typescript": "^5.5.0"
  }
}
