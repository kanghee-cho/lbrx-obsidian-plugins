{
  "name": "lbrx-obsidian-plugins",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for LBRX Obsidian plugins with shared internal packages",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r --filter=./plugins/* run build",
    "dev": "pnpm -r --parallel --filter=./plugins/* run dev",
    "lint": "eslint . --ext .ts",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.24.0",
    "eslint": "^8.57.0",
    "typescript": "^5.5.0"
  }
}
